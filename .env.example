# Public client values. Defaults for official Everchat are committed in
# `.env.production` / `.env.development` so `pnpm build` works with no extra
# files. Copy this to `.env.local` only when testing a contribution against a
# non-production backend. Publishing your own Everchat service is not licensed.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Associated RP domain for WebAuthn (brand domain — NOT the chrome-extension ID)
VITE_WEBAUTHN_RP_ID=everch.at
VITE_WEBAUTHN_RP_NAME=Everchat

# Edge Function secrets (set via `supabase secrets set`, never in the extension)
# SUPABASE_SERVICE_ROLE_KEY=...
# GIPHY_API_KEY=...
# TRANSLATE_API_KEY=...   # Google Cloud Translation API key (or GOOGLE_TRANSLATE_API_KEY)
# WEBAUTHN_RP_ID=everch.at
# WEBAUTHN_RP_NAME=Everchat
# WEBAUTHN_ORIGIN=chrome-extension://igfakbmcceaekceoahmecaecfeoidpdc,chrome-extension://hnafijpegchmgpmkefjihhfpegonnjdb,chrome-extension://apoahddgobmmgdbjcphhelolagklgkil,chrome-extension://mnncloenhbfhdiaffjmmgljfjcagigaj,https://everch.at
# JWT_SECRET=<project HS256 JWT signing secret>
#
# WEBAUTHN_RP_ID must be a real domain (everch.at). Do not use the extension ID.
# List every extension origin in WEBAUTHN_ORIGIN and in www/.well-known/webauthn.
# wxt.config.ts pins `manifest.key` (stable ID hnafij…) and must include
# host_permissions https://everch.at/* so Chrome allows claiming that RP ID.
