{
  "name": "everchat",
  "description": "Public comments on any URL. Chrome side panel.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://everch.at",
  "bugs": {
    "url": "https://github.com/everchathq/everchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everchathq/everchat.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts || echo 'Link Supabase to generate types'",
    "test": "vitest run",
    "locales:sync": "mkdir -p www/locales && cp lib/i18n/locales/*.json www/locales/"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@simplewebauthn/browser": "^14.0.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.20.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
